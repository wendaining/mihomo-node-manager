[Unit]
Description=Mihomo Allowed-Node Manager
Documentation=https://wiki.metacubex.one/en/api/
Wants=network-online.target mihomo.service
After=network-online.target mihomo.service

[Service]
Type=simple
User=mihomo-node-manager
Group=mihomo-node-manager
# The default pingpong env_file = ".env" resolves against this directory, so
# the CPA credentials live in /etc/mihomo-node-manager/.env.
WorkingDirectory=/etc/mihomo-node-manager
ExecStartPre=@BINARY_PATH@ --config /etc/mihomo-node-manager/config.toml --check-config
ExecStart=@BINARY_PATH@ --config /etc/mihomo-node-manager/config.toml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
StateDirectory=mihomo-node-manager
StateDirectoryMode=0750
UMask=0027

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
# The installer renders "true" for a system-owned binary; "read-only" is used
# instead when the binary lives under /home or /root so it stays executable.
ProtectHome=@PROTECT_HOME@
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
