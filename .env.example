# mihomo-node-manager —— CPA (cli-proxy-api) Gemini ping-pong 探测配置
#
# 本地开发：把本文件复制为仓库根目录的 .env（已被 .gitignore 忽略，不会提交）
#   cp .env.example .env && $EDITOR .env
#
# 服务器：/etc/mihomo-node-manager/.env（服务的工作目录由 systemd unit 指向
# /etc/mihomo-node-manager，因此默认的 env_file = ".env" 就会读到它）
#   sudo cp /etc/mihomo-node-manager/.env.example /etc/mihomo-node-manager/.env
#   sudo $EDITOR /etc/mihomo-node-manager/.env
#   sudo chown root:mihomo-node-manager /etc/mihomo-node-manager/.env
#   sudo chmod 640 /etc/mihomo-node-manager/.env
#   sudo systemctl restart mihomo-node-manager
#
# 说明：
# - 服务启动时会先加载 env_file，再读进程环境变量；已存在的同名变量优先。
# - CPA_BASE_URL 和 CPA_MODEL 都非空时 ping-pong 探测才会启用；只填其一会在
#   启动时报错。全部留空 = 功能关闭，行为与旧版本完全一致。
# - 探测判据：只有 CPA 返回 HTTP 400 "User location is not supported"
#   (FAILED_PRECONDITION) 才把节点判为脏；503 auth_unavailable 等 CPA 自身
#   问题视为不确定，不会影响节点选择。

# CPA 的 OpenAI 兼容入口。以下三种写法等价（自动拼接 /v1/chat/completions）：
#   http://127.0.0.1:8317
#   http://127.0.0.1:8317/v1
#   http://127.0.0.1:8317/v1/chat/completions
CPA_BASE_URL=

# CPA 的 API Key（请求携带 Authorization: Bearer <key>）。CPA 未开鉴权就留空。
CPA_API_KEY=

# ping-pong 使用的模型名，必须与 CPA 实际支持的一致，也就是日志里
# providers=antigravity, model=... 的那个名字。
CPA_MODEL=
